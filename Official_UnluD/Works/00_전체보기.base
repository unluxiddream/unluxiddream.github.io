filters:
  and:
    - file.folder == "Works"
    - file.ext != "base"
views:
  - type: table
    name: View
    filters:
      and:
        - "!roles.containsAny()"
    groupBy:
      property: work_type
      direction: ASC
    order:
      - featured
      - file.name
      - title
      - genres
    sort:
      - property: release_date
        direction: ASC
    columnSize:
      note.featured: 24
      file.name: 17
      note.title: 213
