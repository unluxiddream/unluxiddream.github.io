---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import FilterBar from '../components/FilterBar.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { getWorksByTab } from '../lib/works';

const works = await getWorksByTab('other');
---
<BaseLayout title="Other Works" active="other">
  <PageHead title="Other Works" count={works.length} sort>
    <FilterBar tab="other" />
  </PageHead>
  <section class="wrap section section--grid">
    <WorkGrid works={works} tab="other" />
  </section>
</BaseLayout>
