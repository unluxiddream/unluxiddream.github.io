---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import AboutView from '../../components/AboutView.astro';
import type { AboutData } from '../../lib/about';

/* 이 아래 data 객체만 수정하면 About 페이지 내용이 바뀝니다 */
const data: AboutData = {
  intro: [
    '小学入学时开始学习古典钢琴，升入初中后转向流行钢琴，并开始自学作曲。',
    '虽然考入了工科大学，却始终无法放弃音乐，于是以双专业的形式选择了古典作曲，走到了今天。',
    '将迄今所学的一切音乐相互连接、融合，追求无法以特定类型或形式定义的「属于自己的音乐」。',
  ],
  labels: {
    fields: '活动领域', education: '学历', discography: '唱片', projects: '项目',
    activities: '其他活动', portfolio: '代表作品', contact: '联系方式',
    viewWork: '查看作品', viewTab: '浏览列表',
