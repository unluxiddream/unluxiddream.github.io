    { year: '2026', title: '音乐剧《독왕전기》选曲 일생희 I (Original Musical Soundtrack)', format: 'Single', workId: 'ilsaenghui1' },
    { year: '2026', title: '有', format: 'Single', workId: 'yuuwaeru' },
    { year: '2026', title: '为管弦乐团而作的《神化》', format: 'Single', workId: 'shinhwafororchestra' },
