    { year: '2024', title: '시기, 운, 운명', format: 'Single', workId: 'timing-luck-fate' },
    { year: '2023', title: '천 년의 숲', format: 'Single', workId: '1000forest' },
  ],
  projects: [{ year: '2026〜', title: 'Project・LuDiA' }],
