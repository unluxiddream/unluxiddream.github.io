    { year: '2026', title: '有 (Yuu)', format: 'Single', workId: 'yuuwaeru' },
    { year: '2026', title: '\'Shinhwa\' for Orchestra — 오케스트라를 위한 신화(神化)', format: 'Single', workId: 'shinhwafororchestra' },
