import type { AboutData } from '../../lib/about';

/* 이 아래 data 객체만 수정하면 About 페이지 내용이 바뀝니다 */
const data: AboutData = {
  intro: [
    'I began learning classical piano the year I entered elementary school. In middle school I switched to pop piano, and started teaching myself composition.',
    'I went on to an engineering college, but I could not give up on music — so I took up classical composition as a double major, which has led me to where I am today.',
    'Connecting and combining every kind of music I have learned, I pursue “my own music”: something that cannot be defined by any single genre or form.',
  ],
  labels: {
    fields: 'Fields', education: 'Education', discography: 'Discography', projects: 'Projects',
    activities: 'Other Activities', portfolio: 'Selected Works', contact: 'Contact',
    viewWork: 'View work', viewTab: 'Browse works',
  },
  fields: [
    { label: 'Vocals', to: 'music/?filter=vocal' },
    { label: 'Composition', to: 'music/?filter=compose' },
    { label: 'Arrangement', to: 'music/?filter=arrange' },
    { label: 'Lyrics', to: 'music/?filter=lyrics' },
    { label: 'Design', to: 'visual/?filter=design' },
    { label: 'Illustration', to: 'visual/?filter=illust' },
    { label: 'Video', to: 'visual/?filter=video' },
