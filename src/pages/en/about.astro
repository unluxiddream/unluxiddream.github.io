  ],
  discography: [
    { year: '2026', title: '{title}', format: 'Single', workId: 'ilsaenghui1' },
    { year: '2026', title: '{title}', format: 'Single', workId: 'yuuwaeru' },
    { year: '2026', title: '{title}', format: 'Single', workId: 'shinhwafororchestra' },
