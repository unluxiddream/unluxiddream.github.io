    { year: '2026–', title: 'UnTuned Live Challenge', workId: 'cover_untunedlivechallange' },
    { year: '2026–', title: 'LeXidN — VOCALOID × producer unit', url: 'https://www.youtube.com/playlist?list=PLNbkmfiKfi0M' },
