---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import { withBase } from '../lib/url';
---
<BaseLayout title="404">
  <section class="wrap nf">
    <img class="nf-mark" src={withBase('favicon.svg')} alt="" width="72" height="72" />
    <p class="nf-code">404</p>
    <p class="nf-msg"><T k="nf.title" /></p>
    <a class="btn btn--primary btn--lg" href={withBase('')}><T k="nf.home" /></a>
  </section>
</BaseLayout>
