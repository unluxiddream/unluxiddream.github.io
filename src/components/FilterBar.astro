---
import T from './T.astro';
import { FILTERS, VOCAL_TONES, VOCAL_VOICES } from '../config/site';
import type { Tab } from '../lib/works';

interface Props {
  tab: Tab;
  target?: string;
}
const { tab, target = 'works' } = Astro.props;
const filters = FILTERS[tab];
---
<div class="filters" data-filters-bar data-target={target}>
  <span class="sr-only"><T k="filter.label" /></span>
  <button type="button" class="filter is-active" data-filter="all" aria-pressed="true"><T k="filter.all" /></button>
  {filters.map((f) => (
    <button type="button" class="filter" data-filter={f.key} aria-pressed="false"><T v={f.label} /></button>
  ))}
</div>

{/* 보조 필터: Music & Audio 에서 「보컬」 버튼이 켜졌을 때만 펼쳐짐 */}
{tab === 'music' && (
  <div class="subfilters" data-subfilters data-for="vocal" hidden>
    {[
      { name: 'tone', k: 'meta.vocalTone' as const, items: VOCAL_TONES },
      { name: 'voice', k: 'meta.vocalVoice' as const, items: VOCAL_VOICES },
    ].map((g) => (
      <div class="subfilter-group" data-sub={g.name} role="group">
        <span class="subfilter-label"><T k={g.k} /></span>
        <button type="button" class="subfilter is-active" data-value="all" aria-pressed="true"><T k="filter.all" /></button>
        {g.items.map((it) => (
          <button type="button" class="subfilter" data-value={it.key} aria-pressed="false"><T v={it.label} /></button>
        ))}
      </div>
    ))}
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-filters-bar]').forEach((bar) => {
    const grid = document.getElementById(bar.dataset.target || 'works');
    if (!grid) return;
    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    const counter = document.querySelector<HTMLElement>('[data-count]');
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const sub = bar.nextElementSibling?.matches('[data-subfilters]') ? (bar.nextElementSibling as HTMLElement) : null;
    const groups = sub ? [...sub.querySelectorAll<HTMLElement>('[data-sub]')] : [];
    let keys: string[] = ['all'];
    /** 보조 필터 선택값 (예: { tone: 'high', voice: 'all' }) */
    const subSel: Record<string, string> = Object.fromEntries(groups.map((g) => [g.dataset.sub!, 'all']));

    /** 선택한 key 들 중 하나라도 해당하는 작품을 표시 (버튼 클릭은 1개, 주소로 들어올 땐 여러 개 가능) */
    function apply() {
        const all = keys.includes('all');
        const subOn = !!sub && keys.length === 1 && keys[0] === sub.dataset.for;
        if (sub) sub.hidden = !subOn;
        buttons.forEach((b) => {
          const on = keys.includes(b.dataset.filter!);
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', String(on));
        });
        let shown = 0;
        grid!.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
          const mine = (card.dataset.filters || '').split(' ');
          let ok = all || keys.some((k) => mine.includes(k));
          // 보조 필터: 카드의 data-tone / data-voice 에 선택한 값이 있어야 표시
          if (ok && subOn) {
            for (const [name, val] of Object.entries(subSel)) {
              if (val !== 'all' && !(card.dataset[name] || '').split(' ').includes(val)) ok = false;
            }
          }
          card.hidden = !ok;
          if (ok) shown++;
        });
        if (counter) counter.textContent = String(shown);
        if (empty) empty.hidden = shown > 0;
    }

    function select(next: string[]) {
      keys = next;
      // 상위 필터를 바꾸면 보조 필터는 「전체」로 초기화
      for (const name of Object.keys(subSel)) setSub(name, 'all', false);
      apply();
    }

    function setSub(name: string, value: string, run = true) {
      subSel[name] = value;
      groups.find((g) => g.dataset.sub === name)?.querySelectorAll<HTMLButtonElement>('[data-value]').forEach((b) => {
        const on = b.dataset.value === value;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
      if (run) apply();
    }

    buttons.forEach((btn) => btn.addEventListener('click', () => select([btn.dataset.filter!])));
    groups.forEach((g) =>
      g.querySelectorAll<HTMLButtonElement>('[data-value]').forEach((b) => b.addEventListener('click', () => setSub(g.dataset.sub!, b.dataset.value!))),
    );

    // 주소에 ?filter=키 (쉼표로 여러 개 가능: ?filter=mix,master) 가 붙어 들어오면 해당 버튼을 켠 상태로 시작
    // (Home 「Works」 칸, About 「활동 분야」 링크 등)
    // 보조 필터는 ?filter=vocal&tone=high&voice=head 처럼 지정 (작업물 상세 페이지의 보컬 톤 · 발성 태그 링크)
    const params = new URLSearchParams(location.search);
    const valid = new Set(buttons.map((b) => b.dataset.filter!));
    const preset = (params.get('filter') ?? '').split(',').map((k) => k.trim()).filter((k) => valid.has(k));
    if (preset.length) {
      select(preset);
      for (const g of groups) {
        const v = params.get(g.dataset.sub!);
        if (v && g.querySelector(`[data-value="${CSS.escape(v)}"]`)) setSub(g.dataset.sub!, v, false);
      }
      apply();
    }
  });
</script>
