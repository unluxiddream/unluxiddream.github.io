---
import SearchForm from './SearchForm.astro';
---
<div class="searchbox" data-searchbox>
  <button type="button" class="ctrl search-toggle" aria-label="Search" aria-expanded="false" aria-controls="search-panel">
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="6.5" cy="6.5" r="5" /><path d="M10.2 10.2 L15 15" /></svg>
  </button>
  <div class="search-panel" id="search-panel" hidden>
    <SearchForm id="search-q-panel" />
  </div>
</div>
